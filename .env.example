# ==============================================================
# BLENDIFY — Environment Variables Reference Checklist (.env.example)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ==============================================================

# ── Core App & Auth ───────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/blendify

# ── Payment Gateways ──────────────────────────────────────────
# Razorpay (India & International UPI/Cards)
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe (Global Credit Cards & Digital Wallets)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx

# ── Email Communication ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxx
CONTACT_EMAIL=support@blendify.coffee
EMAIL_FROM=Blendify <no-reply@blendify.coffee>

# ── Media & Asset Storage ─────────────────────────────────────
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxx
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=blendify-media-bucket

# ── Analytics & Monitoring ────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GTM_CONTAINER_ID=GTM-XXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_KEY=google-site-verification-xxxxxx

# ── Social & OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_token

# ── Mapping & Location ────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXX

# ── AI & Background Services ──────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://xxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key
