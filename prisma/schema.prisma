}

// ── Social Links ──────────────────────────────────────────────
model SocialLinks {
  id         Int      @id @default(1)
  instagram  String   @default("")
  facebook   String   @default("")
  linkedin   String   @default("")
  youtube    String   @default("")
  twitter    String   @default("")
  pinterest  String   @default("")
  threads    String   @default("")
  whatsapp   String   @default("")
  updatedAt  DateTime @updatedAt

  @@map("social_links")
}

// ── Navigation Menus ──────────────────────────────────────────
model NavigationMenu {
  id        String   @id @default(cuid())
  location  String   @unique // header | footer | mega
  name      String
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@map("navigation_menus")
}

// ── CMS Pages ─────────────────────────────────────────────────
model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  metaTitle   String   @default("")
  metaDesc    String   @default("")
  isPublished Boolean  @default(true)
  isSystem    Boolean  @default(false) // cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_pages")
}

// ── Blog Categories ───────────────────────────────────────────
model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  imageUrl    String   @default("")
  isActive    Boolean  @default(true)
  postCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_categories")
}

// ── FAQ ───────────────────────────────────────────────────────
model FaqCategory {
  id    String    @id @default(cuid())
  name  String
  slug  String    @unique
  order Int       @default(0)
  items FaqItem[]

  @@map("faq_categories")
}

model FaqItem {
  id         String      @id @default(cuid())
  question   String
  answer     String      @db.Text
  order      Int         @default(0)
  isActive   Boolean     @default(true)
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId])
  @@map("faq_items")
}

// ── Team Members ──────────────────────────────────────────────
model TeamMember {
  id          String   @id @default(cuid())
  name        String
  designation String
  bio         String   @default("") @db.Text
  photoUrl    String   @default("")
  instagram   String   @default("")
  linkedin    String   @default("")
  twitter     String   @default("")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("team_members")
}

// ── Brand Assets ──────────────────────────────────────────────
model BrandAsset {
  id             Int      @id @default(1)
  logoUrl        String   @default("")
  logoDarkUrl    String   @default("")
  logoLightUrl   String   @default("")
  faviconUrl     String   @default("")
  ogImageUrl     String   @default("")
  primaryColor   String   @default("#581312")
  secondaryColor String   @default("#C47C0A")
  accentColor    String   @default("#2C1008")
  fontDisplay    String   @default("Playfair Display")
  fontBody       String   @default("Inter")
  updatedAt      DateTime @updatedAt

  @@map("brand_assets")
}

// ── Integration Settings ──────────────────────────────────────
model IntegrationConfig {
  id          String   @id @default(cuid())
  service     String   @unique // ga | gtm | posthog | sentry | cloudinary | resend | meta_pixel | gsc
  displayName String
  isEnabled   Boolean  @default(false)
  config      Json     @default("{}") // Encrypted keys stored here
  status      String   @default("disconnected") // connected | disconnected | error
  lastSyncAt  DateTime?
  updatedAt   DateTime @updatedAt

  @@map("integration_configs")
}

// ── Feature Flags ─────────────────────────────────────────────
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  label          String
  description    String   @default("")
  isEnabled      Boolean  @default(false)
  isExperimental Boolean  @default(false)
  category       String   @default("general") // general | commerce | marketing | dev
  updatedAt      DateTime @updatedAt

  @@map("feature_flags")
}

// ── Maintenance Config ────────────────────────────────────────
model MaintenanceConfig {
  id           Int      @id @default(1)
  isEnabled    Boolean  @default(false)
  message      String   @default("We'll be right back. Scheduled maintenance in progress.")
  whitelistIps String[] @default([])
  countdownTo  DateTime?
  updatedAt    DateTime @updatedAt

  @@map("maintenance_config")
}

// ── API Keys (Encrypted) ──────────────────────────────────────
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  service     String
  keyHash     String    @db.Text // bcrypt hashed
  keyPreview  String    // First 8 + "..." display
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("api_keys")
}

// ── Webhook Endpoints ─────────────────────────────────────────
model WebhookEndpoint {
  id        String       @id @default(cuid())
  name      String
  url       String
  secret    String       @default("")
  events    String[]
  isActive  Boolean      @default(true)
  logs      WebhookLog[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("webhook_endpoints")
}

model WebhookLog {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  statusCode  Int?
  success     Boolean
  payload     Json
  response    String          @default("") @db.Text
  durationMs  Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([endpointId])
  @@map("webhook_logs")
}

// ── Audit Logs ────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String   @default("")
  action    String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | EXPORT
  module    String   // products | orders | coupons | settings etc.
  entityId  String   @default("")
  entityLabel String @default("")
  before    Json?
  after     Json?
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Staff Invites ─────────────────────────────────────────────
model StaffInvite {
  id          String   @id @default(cuid())
  email       String   @unique
  role        String   @default("SUPPORT")
  invitedBy   String
  status      String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  token       String   @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([token])
  @@map("staff_invites")
}

// ─────────────────────────────────────────────────────────────
// PHASE 3 STEP 4 — CUSTOMER SUPPORT & HELPDESK
// ─────────────────────────────────────────────────────────────

model SupportTicket {
  id              String                @id @default(cuid())
  ticketNumber    String                @unique
  userId          String
  subject         String
  description     String                @db.Text
  category        String
  priority        SupportTicketPriority @default(MEDIUM)
  status          SupportTicketStatus   @default(OPEN)
  assignedToId    String?
  orderId         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([userId])
  @@index([assignedToId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id          String              @id @default(cuid())
  ticketId    String
  senderId    String?
  senderEmail String
  senderName  String
  type        SupportMessageType
  body        String              @db.Text
  isInternal  Boolean             @default(false)
  createdAt   DateTime            @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("support_messages")
}

// ─────────────────────────────────────────────────────────────
// PHASE 3 STEP 5 — AUTOMATION & WORKFLOW ENGINE
// ─────────────────────────────────────────────────────────────

model AutomationRule {
  id           String                 @id @default(cuid())
  name         String
  description  String?                @db.Text
  triggerType  AutomationTriggerType
  triggerConfig Json?                 @default("{}")
  actionType   AutomationActionType
  actionConfig Json?                  @default("{}")
  conditions   Json?                  @default("[]")
  isActive     Boolean                @default(true)
  schedule     String?
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  totalRuns    Int                    @default(0)
  successRuns  Int                    @default(0)
  failureRuns  Int                    @default(0)

  createdById  String
  createdBy    User                   @relation(fields: [createdById], references: [id])

  executions   AutomationExecution[]

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([triggerType])
  @@index([actionType])
  @@index([isActive])
  @@index([createdById])
  @@index([createdAt])
  @@map("automation_rules")
}

model AutomationExecution {
  id          String                    @id @default(cuid())
  ruleId      String
  triggerType AutomationTriggerType
  status      AutomationExecutionStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  result      Json?
  error       String?                   @db.Text

  executedById String?
  executedBy   User?                    @relation(fields: [executedById], references: [id])

  rule        AutomationRule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  createdAt   DateTime                  @default(now())

  @@index([ruleId])
  @@index([status])
  @@index([triggerType])
  @@index([createdAt])
  @@index([executedById])
  @@map("automation_executions")
}

